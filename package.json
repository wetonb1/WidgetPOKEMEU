{
  "name": "meu-widget",
  "version": "1.0.0",
  "description": "Widget pessoal para Windows 10",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable && node tools/finalizar-exe.js",
    "icone": "electron tools/gerar-icone.js",
    "medir": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/medir.ps1"
  },
  "keywords": [],
  "author": "weto",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.meu.widget",
    "productName": "Meu Widget",
    "win": {
      "target": "portable",
      "icon": "assets/icone.ico"
    },
    "asarUnpack": [
      "app/media.ps1",
      "app/helper.cs"
    ],
    "npmRebuild": false,
    "files": [
      "**/*",
      "!tools/**",
      "!dist/**",
      "!docs/**",
      "!*.md",
      "!*.vbs",
      "!*.bat",
      "!*.exe",
      "!assets/icone.png"
    ],
    "artifactName": "MeuWidget.${ext}"
  }
}
